# Токен Травобота от @BotFather
BOT_TOKEN=1234567890:AAH_paste_token_here

# ID Google Sheets таблицы (берётся из URL: docs.google.com/spreadsheets/d/<ВОТ_ЭТО>/edit)
SHEETS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Путь к credentials service-аккаунта внутри контейнера (не меняй)
GOOGLE_CREDENTIALS=/app/credentials.json

# Groq API key (https://console.groq.com)
GROQ_API_KEY=gsk_paste_key_here

# Модель Groq (по умолчанию llama-3.3-70b-versatile, бесплатная и умная)
GROQ_MODEL=llama-3.3-70b-versatile

# Redis (внутри docker-сети)
REDIS_URL=redis://redis:6379/0

# TTL кеша Sheets в секундах (300 = 5 минут)
CACHE_TTL=300

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# === АДМИНКА ===
# Username бота без @ (для Telegram Login Widget)
TG_BOT_USERNAME=Tpabomah_bot

# Домен админки (без https://, без слешей)
ADMIN_DOMAIN=admin.travobot-workflow.ru

# Случайная длинная строка для подписи cookie (придумай свою на 64+ символа)
ADMIN_SECRET=change_me_to_random_long_string_64_chars_or_more

# Whitelist Telegram username которые могут войти как admin при первом входе (через запятую, без @)
INITIAL_ADMINS=Ki1aragg

# Путь к БД (внутри контейнера, не меняй)
DB_PATH=/app/data/travobot.db
IMAGES_DIR=/app/static/images
